{
  "name": "composer-docs-website",
  "version": "0.36.0",
  "private": true,
  "type": "module",
  "scripts": {
    "render": "bun run scripts/render-content.ts",
    "verify:deployed": "bun run scripts/verify-deployed.ts",
    "build": "pnpm run render && rm -rf dist && bun build src/server.ts --target=bun --outfile dist/server.mjs",
    "typecheck": "pnpm run render && tsc --noEmit",
    "test": "pnpm run render && bun test tests",
    "dev": "pnpm run render && bun run src/server.ts",
    "deploy": "pnpm turbo run build --filter composer-docs-website && ( set -a; . \"${PRISMA_DEPLOY_ENV:-../.env}\"; set +a; bun ../node_modules/.bin/prisma deploy --environment \"${DOCS_ENVIRONMENT:-production}\" )",
    "destroy": "( set -a; . \"${PRISMA_DEPLOY_ENV:-../.env}\"; set +a; bun ../scripts/composer-destroy.ts --environment \"${DOCS_ENVIRONMENT:-production}\" )"
  },
  "dependencies": {
    "@prisma/composer": "workspace:0.36.0",
    "@prisma/composer-prisma-cloud": "workspace:0.36.0",
    "alchemy": "https://pkg.alchemy.run/alchemy/972f294ae0c7982a8ebcb551fadd07d29c9c0fca"
  },
  "devDependencies": {
    "@prisma/composer": "workspace:0.36.0",
    "@prisma/composer-cli": "workspace:0.36.0",
    "@prisma/composer-prisma-cloud": "workspace:0.36.0",
    "@prisma/management-api-sdk": "^1.80.0",
    "@types/bun": "^1.3.13",
    "@types/markdown-it": "^14.1.2",
    "markdown-it": "^14.1.0",
    "prisma": "catalog:",
    "shiki": "^4.2.0",
    "typescript": "^6.0.3"
  }
}

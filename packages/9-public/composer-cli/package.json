{
  "name": "@prisma/composer-cli",
  "version": "0.29.1",
  "type": "module",
  "description": "Prisma Composer's command family, which the `prisma` CLI mounts as `deploy`, `dev`, `dev url`, `dev stop` and `emulator list`.",
  "exports": {
    "./family": "./dist/family.mjs",
    "./testing": "./dist/testing.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/composer": "workspace:0.29.1",
    "alchemy": "2.0.0-beta.78",
    "cross-spawn": "^7.0.6",
    "effect": "4.0.0-rc.115",
    "esbuild": "^0.28.1"
  },
  "peerDependencies": {
    "@prisma/cli-engine": "0.7.0"
  },
  "devDependencies": {
    "@internal/cli": "workspace:0.29.1",
    "@internal/dev-emulators": "workspace:0.29.1",
    "@internal/foundation": "workspace:0.29.1",
    "@internal/tsdown-config": "workspace:0.29.1",
    "@types/bun": "^1.3.13",
    "@prisma/cli-engine": "0.7.0",
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.7",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/composer.git",
    "directory": "packages/9-public/composer-cli"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

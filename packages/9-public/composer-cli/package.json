{
  "name": "@prisma/composer-cli",
  "version": "0.6.0",
  "type": "module",
  "description": "Prisma Composer's command family and the `prisma-composer` CLI.",
  "bin": {
    "prisma-composer": "./dist/bin.mjs"
  },
  "exports": {
    "./family": "./dist/family.mjs",
    "./testing": "./dist/testing.mjs",
    "./package.json": "./package.json"
  },
  "files": [

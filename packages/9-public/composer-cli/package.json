    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/composer": "workspace:0.6.0",
    "alchemy": "2.0.0-beta.67",
    "c12": "^3.3.4",
    "effect": "4.0.0-beta.103",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@prisma/cli-engine": "0.1.1"
  },
  "devDependencies": {
    "@internal/cli": "workspace:0.6.0",
    "@internal/tsdown-config": "workspace:0.6.0",
    "@prisma/cli-engine": "0.1.1",
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/composer.git",

{
  "name": "@prisma/composer",
  "version": "0.36.0",
  "type": "module",
  "description": "Prisma Composer \u2014 build a Prisma App by composing Modules. Core authoring, deploy pipeline, and the service-rpc/http/node/nextjs authoring surfaces. The command family the `prisma` CLI mounts lives in @prisma/composer-cli.",
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./internal/pools": "./dist/internal-pools.mjs",
    "./internal/converge": "./dist/internal-converge.mjs",
    "./control": "./dist/control.mjs",
    "./deploy": "./dist/deploy.mjs",
    "./local-target": "./dist/local-target.mjs",
    "./report": "./dist/report.mjs",
    "./testing": "./dist/testing.mjs",
    "./casts": "./dist/casts.mjs",
    "./assertions": "./dist/assertions.mjs",
    "./arktype": "./dist/arktype.mjs",
    "./zod": "./dist/zod.mjs",
    "./service-rpc": "./dist/service-rpc.mjs",
    "./http": "./dist/http.mjs",
    "./node": "./dist/node.mjs",
    "./node/control": "./dist/node-control.mjs",
    "./nextjs": "./dist/nextjs.mjs",
    "./nextjs/control": "./dist/nextjs-control.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../../scripts/stage-skills.mjs",
    "clean": "rm -rf dist skills",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "alchemy": "catalog:",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.2",
    "effect": "catalog:",
    "esbuild": "^0.28.1",
    "@prisma/management-api-sdk": "^1.80.0"
  },
  "peerDependencies": {
    "arktype": "^2.2.3",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "arktype": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@internal/assemble": "workspace:0.36.0",
    "@internal/cli": "workspace:0.36.0",
    "@internal/core": "workspace:0.36.0",
    "@internal/foundation": "workspace:0.36.0",
    "@internal/http": "workspace:0.36.0",
    "@internal/lowering": "workspace:0.36.0",
    "@internal/nextjs": "workspace:0.36.0",
    "@internal/node": "workspace:0.36.0",
    "@internal/service-rpc": "workspace:0.36.0",
    "@internal/tsdown-config": "workspace:0.36.0",
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.7",
    "typescript": "^6.0.3",
    "arktype": "^2.2.3",
    "zod": "^4.4.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/composer.git",
    "directory": "packages/9-public/composer"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

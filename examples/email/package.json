{
  "name": "@prisma/example-email",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:deployed": "( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun scripts/smoke.ts )",
    "deploy": "pnpm turbo run build --filter @prisma/example-email... && ( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun node_modules/.bin/prisma-composer deploy module.ts ${EMAIL_STACK_NAME:+--name \"$EMAIL_STACK_NAME\"} )",
    "destroy": "( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun node_modules/.bin/prisma-composer destroy module.ts --production ${EMAIL_STACK_NAME:+--name \"$EMAIL_STACK_NAME\"} )"
  },
  "dependencies": {
    "@prisma/composer": "workspace:0.15.0",
    "@prisma/composer-prisma-cloud": "workspace:0.15.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "arktype": "^2.2.3",
    "hono": "^4.12.31",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@prisma/composer": "workspace:0.15.0",
    "@prisma/composer-cli": "workspace:0.15.0",
    "@prisma/composer-prisma-cloud": "workspace:0.15.0",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "effect": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/sql-sqlite-do": "4.0.0-rc.112"
  }
}

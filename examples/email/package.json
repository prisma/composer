{
  "name": "@prisma/example-email",
  "version": "0.39.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:deployed": "( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun scripts/smoke.ts )",
    "deploy": "pnpm turbo run build --filter @prisma/example-email... && ( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun ../../node_modules/.bin/prisma deploy ${EMAIL_STACK_NAME:+--name \"$EMAIL_STACK_NAME\"} )",
    "destroy": "( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun ../../scripts/composer-destroy.ts --environment production ${EMAIL_STACK_NAME:+--name \"$EMAIL_STACK_NAME\"} )"
  },
  "dependencies": {
    "@prisma/composer": "workspace:0.39.0",
    "@prisma/composer-prisma-cloud": "workspace:0.39.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "arktype": "^2.2.9",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@prisma/composer": "workspace:0.39.0",
    "@prisma/composer-cli": "workspace:0.39.0",
    "@prisma/composer-prisma-cloud": "workspace:0.39.0",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "catalog:",
    "typescript": "^6.0.3"
  }
}

# Local values. Copy this file to .env; dotenv() in prisma.config.ts reads it, and the shell wins over it.
# `prisma deploy` run from this directory also reads EMAIL_DELIVERY_MODE from it and writes it into the deployed service's input. Deploying with this .env loaded gives the deployed environment a mode that sends no email.
# EMAIL_FROM and EMAIL_DELIVERY_CREDENTIAL are platform variables the mail service reads at boot. prisma dev reads them from this file. The deploy does not copy them to the platform: set them there with prisma project env add.
# Delivery mode none sends no email, so the credential is never used.
EMAIL_DELIVERY_MODE=none
EMAIL_FROM=dev@example.com
EMAIL_DELIVERY_CREDENTIAL=local-dev-unused

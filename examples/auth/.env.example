# Local values. Copy this file to .env; dotenv() in prisma.config.ts reads it, and the shell wins over it.
# Also read by `prisma deploy` from this directory, which writes these params into the deployed input: deploying with this .env loaded gives the deployed environment a mode that sends no email. The deploy never copies a secret from this file to the platform; set EMAIL_DELIVERY_CREDENTIAL there with prisma project env add.
# Delivery mode none sends no email, so the credential is never used.
EMAIL_DELIVERY_MODE=none
EMAIL_FROM=dev@example.com
EMAIL_DELIVERY_CREDENTIAL=local-dev-unused

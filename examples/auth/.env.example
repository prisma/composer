# Local values. Copy this file to .env; dotenv() in prisma.config.ts reads it, and the shell wins over it.
# `prisma deploy` run from this directory also reads it and writes these values into the deployed service's input. Deploying with this .env loaded gives the deployed environment a mode that sends no email.
# The deploy does not copy a secret from this file to the platform. Set EMAIL_DELIVERY_CREDENTIAL there with prisma project env add.
# Delivery mode none sends no email, so the credential is never used.
EMAIL_DELIVERY_MODE=none
EMAIL_FROM=dev@example.com
EMAIL_DELIVERY_CREDENTIAL=local-dev-unused

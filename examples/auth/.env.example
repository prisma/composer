# Local values for `prisma dev`. Copy this file to .env; prisma.config.ts loads it.
# Also read by `prisma deploy` from this directory, which uploads any secret the target environment does not have yet and writes these params into the deployed input: deploying with this .env loaded gives the deployed environment a mode that sends no email.
# Delivery mode none sends no email, so the credential is never used.
EMAIL_DELIVERY_MODE=none
EMAIL_FROM=dev@example.com
EMAIL_DELIVERY_CREDENTIAL=local-dev-unused

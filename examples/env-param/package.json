{
  "name": "@prisma/example-env-param",
  "version": "0.35.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build src/server.ts --target=bun --outdir dist/server && cp -R src/assets dist/server/assets",
    "typecheck": "tsc --noEmit",
    "dev": "bun run src/server.ts",
    "smoke:deployed": "( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun scripts/smoke.ts )",
    "deploy": "pnpm turbo run build --filter @prisma/example-env-param... && ( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun ../../node_modules/.bin/prisma deploy ${ENV_PARAM_STACK_NAME:+--name \"$ENV_PARAM_STACK_NAME\"} --environment \"${ENV_PARAM_ENVIRONMENT:-production}\" )",
    "destroy": "( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun ../../scripts/composer-destroy.ts --environment production ${ENV_PARAM_STACK_NAME:+--name \"$ENV_PARAM_STACK_NAME\"} )",
    "destroy:environment": "( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun ../../scripts/composer-destroy.ts --environment \"${ENV_PARAM_ENVIRONMENT:?ENV_PARAM_ENVIRONMENT is required}\" ${ENV_PARAM_STACK_NAME:+--name \"$ENV_PARAM_STACK_NAME\"} )"
  },
  "dependencies": {
    "@prisma/composer": "workspace:0.35.0",
    "@prisma/composer-cli": "workspace:0.35.0",
    "@prisma/composer-prisma-cloud": "workspace:0.35.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "prisma": "catalog:",
    "typescript": "^6.0.3"
  }
}

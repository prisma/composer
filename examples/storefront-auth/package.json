{
  "name": "@prisma/example-storefront-auth",
  "version": "0.36.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo 'nothing to build for this package itself — @storefront-auth/auth and @storefront-auth/storefront build via turbo ^build, from the workspace deps below'",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm turbo run build --filter @prisma/example-storefront-auth... && ( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun ../../node_modules/.bin/prisma deploy ${STOREFRONT_STACK_NAME:+--name \"$STOREFRONT_STACK_NAME\"} )",
    "destroy": "( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun ../../scripts/composer-destroy.ts --environment production ${STOREFRONT_STACK_NAME:+--name \"$STOREFRONT_STACK_NAME\"} )",
    "test": "bun test module.test.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.0",
    "@prisma/composer": "workspace:0.36.0",
    "@prisma/composer-prisma-cloud": "workspace:0.36.0",
    "@storefront-auth/auth": "workspace:0.36.0",
    "@storefront-auth/storefront": "workspace:0.36.0",
    "alchemy": "https://pkg.alchemy.run/alchemy/972f294ae0c7982a8ebcb551fadd07d29c9c0fca",
    "arktype": "^2.2.3",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "@prisma/composer": "workspace:0.36.0",
    "@prisma/composer-cli": "workspace:0.36.0",
    "@types/bun": "^1.3.13",
    "prisma": "catalog:",
    "typescript": "^6.0.3"
  }
}

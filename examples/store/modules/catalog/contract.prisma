// use prisma-8
//
// catalog's data contract: the menu, and a single-row Special pointing at the
// current special of the day (the promotions cron job advances it).

model Product {
  id          String @id
  name        String
  description String
  priceCents  Int
  @@map("product")
}

model Special {
  id        Int    @id
  productId String
  @@map("special")
}

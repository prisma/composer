{
  "name": "@prisma/example-storage",
  "version": "0.29.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist/blobs && bun build src/blobs/server.ts --target=bun --outfile dist/blobs/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "deploy": "pnpm turbo run build --filter @prisma/example-storage... && ( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun ../../node_modules/.bin/prisma deploy module.ts ${STORAGE_STACK_NAME:+--name \"$STORAGE_STACK_NAME\"} )",
    "destroy": "( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun ../../scripts/composer-destroy.ts module.ts --production ${STORAGE_STACK_NAME:+--name \"$STORAGE_STACK_NAME\"} )"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@prisma/composer": "workspace:0.29.0",
    "@prisma/composer-prisma-cloud": "workspace:0.29.0",
    "alchemy": "2.0.0-beta.81",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@prisma/composer": "workspace:0.29.0",
    "@prisma/composer-cli": "workspace:0.29.0",
    "@prisma/composer-prisma-cloud": "workspace:0.29.0",
    "@types/bun": "^1.3.13",
    "prisma": "catalog:",
    "typescript": "^6.0.3"
  }
}

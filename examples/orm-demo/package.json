{
  "name": "@prisma/example-orm-demo",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build src/server.ts --target=bun --outfile dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm turbo run build --filter @prisma/example-orm-demo... && ( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun ../../node_modules/.bin/prisma deploy module.ts ${ORM_DEMO_STACK_NAME:+--name \"$ORM_DEMO_STACK_NAME\"} )",
    "destroy": "( set -a; . \"${PRISMA_DEPLOY_ENV:-../../.env}\"; set +a; bun ../../scripts/composer-destroy.ts module.ts --production ${ORM_DEMO_STACK_NAME:+--name \"$ORM_DEMO_STACK_NAME\"} )"
  },
  "dependencies": {
    "@prisma/composer": "workspace:0.26.0",
    "@prisma/composer-prisma-cloud": "workspace:0.26.0",
    "@prisma/orm-postgres": "8.0.0-rc.13",
    "effect": "4.0.0-rc.115",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@prisma/composer": "workspace:0.26.0",
    "@prisma/composer-cli": "workspace:0.26.0",
    "@prisma/management-api-sdk": "^1.80.0",
    "@types/bun": "^1.3.13",
    "prisma": "catalog:",
    "typescript": "^6.0.3"
  }
}
